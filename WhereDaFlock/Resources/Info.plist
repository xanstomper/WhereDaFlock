<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>WhereDaFlock</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>com.wheredaflock.app</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>WhereDaFlock</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>WhereDaFlock needs location access to show nearby cameras, alerts, and provide navigation. Your location is processed locally and never stored.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>WhereDaFlock needs your location to show your position on the map and provide navigation assistance.</string>
    <key>NSLocationAlwaysUsageDescription</key>
    <string>WhereDaFlock needs background location to alert you about cameras and hazards while you drive.</string>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>WhereDaFlock uses Bluetooth to detect nearby devices and help you understand your wireless environment.</string>
    <key>NSBluetoothPeripheralUsageDescription</key>
    <string>WhereDaFlock scans for nearby Bluetooth devices to provide environmental awareness.</string>
    <key>NSCameraUsageDescription</key>
    <string>WhereDaFlock uses the camera for AI-powered infrastructure detection (optional feature).</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>WhereDaFlock may use the microphone for voice commands (future feature).</string>
    <key>NSMotionUsageDescription</key>
    <string>WhereDaFlock uses motion sensors to detect driving patterns and road conditions.</string>
    <key>UIBackgroundModes</key>
    <array>
        <string>location</string>
        <string>bluetooth-central</string>
        <string>fetch</string>
        <string>processing</string>
    </array>
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>armv7</string>
        <string>gps</string>
        <string>location-services</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <string>comgooglemaps</string>
        <string>comgooglemapsurl</string>
    </array>
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array>
        <string>com.wheredaflock.locationrefresh</string>
        <string>com.wheredaflock.camerarefresh</string>
    </array>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
</dict>
</plist>
